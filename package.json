{
  "name": "deep-blue-feast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:journey": "node --import tsx tests/journey-run.ts",
    "test:endurance": "node --import tsx tests/endurance-run.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json index.html"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
